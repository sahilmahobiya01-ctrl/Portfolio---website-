<!DOCTYPE html>
<html>
<head>
    <title>My Portfolio</title>
    <style>
        body {
            font-family: Arial;
            text-align: center;
            background: #f4f4f4;
            padding: 50px;
        }

        .card {
            background: white;
            padding: 30px;
            max-width: 600px;
            margin: auto;
            border-radius: 15px;
        }

        h1 {
            color: #333;
        }

        p {
            color: #666;
        }

        button {
            padding: 12px 25px;
            background: #333;
            color: white;
            border: none;
            border-radius: 8px;
        }
    </style>
</head>

<body>
    <div class="card">
        <h1>My Portfolio</h1>
        <h2>Front-End Developer</h2>
        <p>Hello! I am a computer science graduate interested in web design and front-end development.</p>
        <p>Skills: HTML, CSS, JavaScript</p>
        <button>Contact Me</button>
    </div>
</body>
</html>
